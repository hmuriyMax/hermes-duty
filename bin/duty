#!/usr/bin/env python3
"""`bin/duty` — CLI hermes-duty: та же логика, что у роутов, из терминала.

    bin/duty now [--repo R] [--state S]
    bin/duty deal <deal_id>
    bin/duty attempts <deal_id>
    bin/duty stats [--repo R] [--since D]
    bin/duty deals [--status done,archived] [--repo R] [--limit N]
                                       (завершённые дела: причина, этапы, числа журнала)
    bin/duty why <deal_id>
    bin/duty why <deal_id> <этап>   (плюс приговор последней попытки этапа)
    bin/duty watch [--interval 10]
    bin/duty run <deal_id> [--spec <duty.yaml>] [--max-steps N] [--once]
                                       (движок доводит дело: решение → шаг → журнал)
    bin/duty reap [--dry-run]          (закрыть осиротевшие попытки: лизинг истёк или умер pid)
    bin/duty lead <deal_id> [--run-budget SEC] [--max-resumes N] [--wait]
                                       (супервизор лида: жив → ничего, умер → резюм с дайджестом)
    bin/duty demo [--keep]
    bin/duty spec check <file>   (OK либо file:line: правило: текст; --json — та же форма)
    --json  (глобальный флаг: ровно форма роута)

Дело адресуется своим id `d_<hex>` (0.0.6: доск нет), а группируется по `repo`:
`now`, `deal` и `stats` печатают группы по репозиториям, «без репозитория» —
отдельной группой. Параметра доски нет ни у одной команды.

Здесь только запуск: разбор команд, вызовы бэкенда и оформление живут в
`dashboard/cli.py`, рядом с роутами, которые он использует. Второго набора правил
состояний в терминале нет — `--json` печатает ответ роута дословно.
"""

from __future__ import annotations

import importlib.util
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# Пакета у `dashboard/` нет (плагин грузит модули по пути), поэтому CLI берём тем же
# способом и под стабильным именем — второй загрузки в процессе не будет.
CLI_MODULE_NAME = "hermes_duty_cli"


def main(argv: list[str]) -> int:
    """Загрузить `dashboard/cli.py` и выполнить команду."""
    path = ROOT / "dashboard" / "cli.py"
    spec = importlib.util.spec_from_file_location(CLI_MODULE_NAME, path)
    if spec is None or spec.loader is None:  # pragma: no cover - файл выпал из сборки
        print(f"duty: CLI module not found: {path}", file=sys.stderr)
        return 2
    module = importlib.util.module_from_spec(spec)
    sys.modules[CLI_MODULE_NAME] = module
    spec.loader.exec_module(module)
    return module.main(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
